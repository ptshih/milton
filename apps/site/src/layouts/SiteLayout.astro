---
import "@milton/theme/base";
import { folderMark } from "@milton/theme/brand";

interface Props {
  title: string;
  description: string;
  legal?: boolean;
}
const { title, description, legal = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <nav class="wrap navigation" aria-label="Main">
        <a class="brand" href="/" aria-label="Milton home">
          <Fragment set:html={folderMark} />
          <span>Milton</span>
        </a>
        <div class="nav-links">
          <a href="/#how-it-works">How it works</a>
          <a class="button secondary" href="https://app.meetmilton.com/">
            Open Milton
          </a>
        </div>
      </nav>
    </header>
    <main id="main" tabindex="-1" class:list={["wrap", { legal }]}>
      <slot />
    </main>
    <footer class="wrap">
      <div class="footer-links">
        <span>© 2026 Zone of Danger, LLC</span>
        <nav aria-label="Legal">
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
        </nav>
        <a href="mailto:peter@meetmilton.com">Contact: peter@meetmilton.com</a>
      </div>
      {!legal && (
        <p class="footer-aside">
          A small website with strong feelings about punctuation.
        </p>
      )}
    </footer>
  </body>
</html>

<style>
  .wrap {
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 40px;
  }
  .site-header {
    border-bottom: 1px solid var(--hairline);
  }
  .navigation {
    min-height: 80px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 12px;
    flex-wrap: wrap;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
    font-size: 14px;
  }
  .nav-links > a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  .nav-links > a:not(.button) {
    text-decoration: none;
  }
  .nav-links > a:not(.button):hover {
    text-decoration: underline;
  }
  .legal {
    max-width: 760px;
    padding-block: 64px 96px;
  }
  .legal :global(h1) {
    font-size: clamp(32px, 5vw, 40px);
    margin: 0 0 24px;
  }
  .legal :global(h2) {
    font-size: 26px;
    margin: 36px 0 12px;
  }
  .legal :global(p) {
    margin: 16px 0 0;
    line-height: 1.75;
  }
  .legal :global(.updated) {
    margin: 12px 0 32px;
    color: var(--muted);
    font: 12px/1.6 var(--font-mono);
  }
  footer {
    padding-block: 24px 32px;
  }
  .footer-links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    border-top: 1px solid var(--hairline);
    padding-top: 16px;
    font-size: 12px;
    color: var(--muted);
  }
  .footer-links nav {
    display: flex;
    gap: 20px;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .footer-links > a {
    margin-left: auto;
  }
  .footer-aside {
    margin: 12px 0 0;
    color: var(--muted);
    font: 11px/1.6 var(--font-mono);
  }
  @media (max-width: 600px) {
    .wrap {
      padding-inline: 20px;
    }
    .navigation {
      gap: 8px 20px;
    }
    .nav-links {
      gap: 12px;
      font-size: 12px;
    }
    .nav-links .button {
      padding-inline: 16px;
      font-size: 12px;
    }
    .legal {
      padding-block: 40px 56px;
    }
    .footer-links > a {
      margin-left: 0;
    }
  }
</style>
