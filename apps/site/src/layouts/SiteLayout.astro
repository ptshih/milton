---
import "@milton/theme/base";
import milton from "../../../../design/milton.png";

interface Props {
  title: string;
  description: string;
  legal?: boolean;
}

const { title, description, legal = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={milton.src} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(milton.src, Astro.site).href} />
    <meta property="og:image:alt" content="Milton holding his red stapler" />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="page">
      <header>
        <a class="wordmark" href="/" aria-label="Milton home">
          milton<span aria-hidden="true">.</span>
        </a>
        <a class="open-app" href="https://app.meetmilton.com/">
          Open Milton
        </a>
      </header>

      <main id="main" class={legal ? "legal" : undefined}>
        <slot />
      </main>

      <footer>
        <span>© 2026 Zone of Danger, LLC</span>
        <nav aria-label="Legal">
          <a href="/privacy">Privacy</a>
          <span aria-hidden="true">·</span>
          <a href="/terms">Terms</a>
        </nav>
        <a href="mailto:peter@meetmilton.com">Contact: peter@meetmilton.com</a>
      </footer>
    </div>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }
  :global(body) {
    margin: 0;
  }
  :global(a) {
    color: inherit;
    text-decoration: none;
  }
  :global(a:focus-visible) {
    outline: 2px solid var(--ink);
    outline-offset: 6px;
  }
  .page {
    width: min(100% - 64px, 1040px);
    margin-inline: auto;
  }
  header {
    min-height: 104px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .open-app {
    font-size: 15px;
    font-weight: 600;
    text-underline-offset: 4px;
  }
  .wordmark {
    font-size: 28px;
    font-weight: 750;
    letter-spacing: -1.5px;
  }
  .wordmark span {
    color: var(--muted);
  }
  .legal {
    max-width: 680px;
    margin-inline: auto;
    padding: 48px 0 80px;
  }
  .legal :global(h1) {
    margin: 0;
    font-size: clamp(36px, 5vw, 48px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
  }
  .legal :global(h2) {
    margin: 32px 0 8px;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .legal :global(p) {
    margin: 16px 0 0;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.75;
  }
  .legal :global(h2 + p) {
    margin-top: 0;
  }
  .legal :global(.updated) {
    margin: 12px 0 32px;
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .legal :global(a),
  footer a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .legal :global(a) {
    overflow-wrap: anywhere;
  }
  footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding: 24px 0 32px;
    border-top: 1px solid var(--hairline);
    color: var(--muted);
    font-size: 12px;
  }
  footer nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  footer a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }
  footer > a {
    margin-left: auto;
  }
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    padding: 12px 16px;
    background: var(--ink);
    color: var(--on-ink);
    transform: translateY(-200%);
  }
  .skip-link:focus {
    transform: translateY(0);
  }
  @media (max-width: 640px) {
    .page {
      width: calc(100% - 48px);
    }
    header {
      min-height: 80px;
    }
    .legal {
      padding: 32px 0 56px;
    }
    footer > a {
      margin-left: 0;
    }
  }
</style>
