{
  "name": "milton",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "server"
    ],
    "catalog": {
      "@types/node": "26.2.0",
      "@types/bun": "1.4.2",
      "bun-types": "1.4.2",
      "typescript": "7.0.2"
    }
  },
  "scripts": {
    "dev": "bun run --cwd apps/site dev",
    "build": "bun run --cwd apps/site build",
    "check-types": "bun run --workspaces --if-present check-types",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "better-auth@1.7.6": "1.7.7",
    "@better-auth/core@1.7.6": "1.7.7",
    "@better-auth/oauth-provider@1.7.6": "1.7.7",
    "zod@4.5.4": "4.6.7",
    "html-to-text": {
      "deepmerge": "4.1.2"
    }
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "prettier": "3.9.7",
    "prettier-plugin-astro": "1.1.0",
    "typescript": "catalog:"
  }
}
